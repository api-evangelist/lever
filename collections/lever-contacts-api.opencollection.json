              }
            ]
          },
          "docs": "Retrieve contact"
        },
        {
          "info": {
            "name": "Update contact",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.lever.co/v1/contacts/:contact",
            "params": [
              {
                "name": "contact",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update contact"
        }
      ]
    }
  ],
  "bundled": true
}